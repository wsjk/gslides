 "cells": [
  {
   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Copy Slide Feature Demo\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook demonstrates the new `copy_slide()` functionality in the gslides package.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import gslides\\n\",\n",
    "    \"from gslides import Frame, Presentation, Spreadsheet, Chart, Series\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from sklearn import datasets\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Initialize Credentials\\n\",\n",
    "    \"\\n\",\n",
    "    \"First, initialize your Google API credentials:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Replace with your credentials\\n\",\n",
    "    \"# gslides.initialize_credentials(your_credentials)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Create a Presentation with Template Slides\\n\",\n",
    "    \"\\n\",\n",
    "    \"Let's create a presentation and add a template slide that we'll copy later:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Create a new presentation\\n\",\n",
    "    \"prs = Presentation.create(name='Copy Slide Demo')\\n\",\n",
    "    \"print(f\\\"Created presentation: {prs.presentation_id}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Create a spreadsheet with sample data\\n\",\n",
    "    \"iris = datasets.load_iris()\\n\",\n",
    "    \"iris_df = pd.DataFrame(iris.data, columns=iris.feature_names)\\n\",\n",
    "    \"iris_df['species'] = pd.Categorical.from_codes(iris.target, iris.target_names)\\n\",\n",
    "    \"\\n\",\n",
    "    \"spr = Spreadsheet.create(\\n\",\n",
    "    \"    title='Iris Data',\\n\",\n",
    "    \"    sheet_names=['Sheet1']\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"frame = Frame.create(\\n\",\n",
    "    \"    df=iris_df,\\n\",\n",
    "    \"    spreadsheet_id=spr.spreadsheet_id,\\n\",\n",
    "    \"    sheet_id=spr.sheet_names['Sheet1'],\\n\",\n",
    "    \"    sheet_name='Sheet1',\\n\",\n",
    "    \"    overwrite_data=True\\n\",\n",
    "    \")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Create a template slide with a chart\\n\",\n",
    "    \"sc = Series.scatter(series_columns=iris.target_names.tolist())\\n\",\n",
    "    \"ch = Chart(\\n\",\n",
    "    \"    data=frame.data,\\n\",\n",
    "    \"    x_axis_column='sepal length (cm)',\\n\",\n",
    "    \"    series=[sc],\\n\",\n",
    "    \"    title='{{ CHART_TITLE }}',\\n\",\n",
    "    \"    x_axis_label='Sepal Length',\\n\",\n",
    "    \"    y_axis_label='Petal Width',\\n\",\n",
    "    \"    legend_position='RIGHT_LEGEND',\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"prs.add_slide(\\n\",\n",
    "    \"    objects=[ch],\\n\",\n",
    "    \"    layout=(1, 1),\\n\",\n",
    "    \"    title='{{ SLIDE_TITLE }}',\\n\",\n",
    "    \"    notes='Template slide'\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Template slide created: {prs.slide_ids[0]}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Copy the Template Slide\\n\",\n",
    "    \"\\n\",\n",
    "    \"Now let's use the `copy_slide()` method to duplicate our template:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Copy the template slide (will be inserted right after the original)\\n\",\n",
    "    \"template_slide_id = prs.slide_ids[0]\\n\",\n",
    "    \"new_slide_id = prs.copy_slide(template_slide_id)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Copied slide: {new_slide_id}\\\")\\n\",\n",
    "    \"print(f\\\"Current slides: {prs.slide_ids}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Customize the Copied Slide\\n\",\n",
    "    \"\\n\",\n",
    "    \"Use the templating feature to customize the copied slide:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Customize the first copy\\n\",\n",
    "    \"prs.template(\\n\",\n",
    "    \"    mapping={\\n\",\n",
    "    \"        'SLIDE_TITLE': 'Iris Analysis - Copy 1',\\n\",\n",
    "    \"        'CHART_TITLE': 'Sepal Length vs Petal Width'\\n\",\n",
    "    \"    },\\n\",\n",
    "    \"    slide_ids=[new_slide_id]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Slide customized!\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Create Multiple Copies with Different Content\\n\",\n",
    "    \"\\n\",\n",
    "    \"Let's create several copies and customize each one:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Create 3 more copies\\n\",\n",
    "    \"months = ['January', 'February', 'March']\\n\",\n",
    "    \"\\n\",\n",
    "    \"for month in months:\\n\",\n",
    "    \"    # Copy the template\\n\",\n",
    "    \"    new_slide = prs.copy_slide(template_slide_id)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Customize with month-specific content\\n\",\n",
    "    \"    prs.template(\\n\",\n",
    "    \"        mapping={\\n\",\n",
    "    \"            'SLIDE_TITLE': f'Iris Analysis - {month} 2024',\\n\",\n",
    "    \"            'CHART_TITLE': f'{month} Data Overview'\\n\",\n",
    "    \"        },\\n\",\n",
    "    \"        slide_ids=[new_slide]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    print(f\\\"Created and customized slide for {month}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nTotal slides: {len(prs.slide_ids)}\\\")\\n\",\n",
    "    \"print(f\\\"Slide IDs: {prs.slide_ids}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6. Copy to Specific Position\\n\",\n",
    "    \"\\n\",\n",
    "    \"You can also specify where to insert the copied slide:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Copy to the beginning of the presentation\\n\",\n",
    "    \"title_slide = prs.copy_slide(template_slide_id, insertion_index=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"prs.template(\\n\",\n",
    "    \"    mapping={\\n\",\n",
    "    \"        'SLIDE_TITLE': 'Iris Dataset Analysis',\\n\",\n",
    "    \"        'CHART_TITLE': 'Overview'\\n\",\n",
    "    \"    },\\n\",\n",
    "    \"    slide_ids=[title_slide]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Title slide created at position 0\\\")\\n\",\n",
    "    \"print(f\\\"Current slide order: {prs.slide_ids}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7. Preview Slides\\n\",\n",
    "    \"\\n\",\n",
    "    \"Let's preview some of our created slides:\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Show the first slide\\n\",\n",
    "    \"prs.show_slide(prs.slide_ids[0])\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Show the last slide\\n\",\n",
    "    \"prs.show_slide(prs.slide_ids[-1])\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 8. Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"The `copy_slide()` method provides a powerful way to:\\n\",\n",
    "    \"\\n\",\n",
    "    \"- Duplicate existing slides with all their content intact\\n\",\n",
    "    \"- Control where the copied slide is inserted\\n\",\n",
    "    \"- Combine with templating for efficient bulk slide creation\\n\",\n",
    "    \"- Maintain chart connections to data sources\\n\",\n",
    "    \"\\n\",\n",
    "    \"This is particularly useful for:\\n\",\n",
    "    \"- Creating monthly/quarterly reports with similar layouts\\n\",\n",
    "    \"- Building presentations from templates\\n\",\n",
    "    \"- Rapidly prototyping slide designs\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
